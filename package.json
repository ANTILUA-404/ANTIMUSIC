{
  "name": "antimusic",
  "version": "1.0.0",
  "private": true,
  "description": "ANTIMUSIC - production-oriented Discord music bot powered by Discord.js + Lavalink v4",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "discord.js": "^14.24.0",
    "dotenv": "^16.6.1",
    "lavalink-client": "^2.9.0",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
