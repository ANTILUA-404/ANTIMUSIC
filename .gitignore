# Dependencies
node_modules/

# Production build output
dist/

# Environment secrets (JANGAN DI-UPLOAD KE GITHUB)
.env
.env.local
.env.*.local

# Persistent local data
data/*.json
!data/.gitkeep

# Lavalink binaries & local JRE runtime (Penyebab limit GitHub >100MB)
# Pada deployment (Docker / VPS), Lavalink menggunakan image ghcr.io/lavalink-devs/lavalink
lavalink/Lavalink.jar
lavalink/jre/
lavalink/plugins/
lavalink/logs/
lavalink/*.log

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System files
.DS_Store
Thumbs.db

